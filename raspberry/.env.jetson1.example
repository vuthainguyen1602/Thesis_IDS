# ==============================================================================
# Jetson Nano #1 - Distributed IDS Edge (192.168.1.50)
# Copy to .env on the first Jetson Nano
# ==============================================================================

# --- Node identity ---
EDGE_NODE_ID=jetson-nano-1
EDGE_NODE_ROLE=anomaly_gate
ALERT_ENABLED=0

# --- Kafka (replace with PC/Mac IP) ---
KAFKA_BOOTSTRAP_SERVERS=192.168.1.165:9092
KAFKA_TOPIC=ids-network-flow
KAFKA_SUSPICIOUS_TOPIC=ids-suspicious-flow
KAFKA_GROUP_ID=ids-jetson-cluster

# --- PostgreSQL / InfluxDB ---
POSTGRES_HOST=192.168.1.165
POSTGRES_PORT=5433
POSTGRES_DB=ids_edge
POSTGRES_USER=ids
POSTGRES_PASSWORD=ids_password

INFLUXDB_URL=http://192.168.1.165:8086
INFLUXDB_TOKEN=ids-edge-token
INFLUXDB_ORG=thesis
INFLUXDB_BUCKET=ids_metrics

# --- Edge pipeline (anomaly gate: no Spark needed) ---
EDGE_BATCH_SIZE=32
METRICS_PUSH_INTERVAL=10

# --- Alerts (disabled on gate node; classifier node sends alerts) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=ids-alert@jetson-nano-1.local
ALERT_EMAIL_TO=
WEBHOOK_URL=
