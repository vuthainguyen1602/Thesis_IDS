# ==============================================================================
# Jetson Nano #2 - Distributed IDS Edge
# Copy to .env on the second Jetson Nano
# ==============================================================================

# --- Node identity ---
EDGE_NODE_ID=jetson-nano-2
EDGE_NODE_ROLE=classifier
ALERT_ENABLED=1

# --- Kafka (replace with PC/Mac IP) ---
KAFKA_BOOTSTRAP_SERVERS=192.168.1.225:9092
KAFKA_TOPIC=ids-network-flow
KAFKA_SUSPICIOUS_TOPIC=ids-suspicious-flow
KAFKA_CLASSIFIER_GROUP_ID=ids-classifier-consumer

# --- PostgreSQL / InfluxDB ---
POSTGRES_HOST=192.168.1.225
POSTGRES_PORT=5433
POSTGRES_DB=ids_edge
POSTGRES_USER=ids
POSTGRES_PASSWORD=ids_password

INFLUXDB_URL=http://192.168.1.225:8086
INFLUXDB_TOKEN=ids-edge-token
INFLUXDB_ORG=thesis
INFLUXDB_BUCKET=ids_metrics

# --- Spark (cluster: Mac master; driver on this node when running ML remotely) ---
SPARK_MASTER=spark://192.168.1.225:7077
SPARK_DRIVER_HOST=192.168.1.102
SPARK_EXECUTOR_MEMORY=768m
SPARK_DRIVER_MEMORY=768m
SPARK_SHUFFLE_PARTITIONS=2
SPARK_APP_NAME=IDS_Edge_jetson-nano-2

# Spark cluster mode (optional): uncomment and set Jetson #1 IP
# SPARK_MASTER=spark://192.168.1.101:7077

# --- Edge pipeline ---
EDGE_BATCH_SIZE=16
METRICS_PUSH_INTERVAL=10
ALERT_COOLDOWN=60

# --- Alerts ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=ids-alert@jetson-nano-2.local
ALERT_EMAIL_TO=
WEBHOOK_URL=
