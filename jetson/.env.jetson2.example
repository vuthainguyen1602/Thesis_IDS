# ==============================================================================
# Jetson Nano #2 - Distributed IDS Edge
# Copy to .env on the second Jetson Nano (192.168.1.205)
# ==============================================================================

# --- Node identity ---
EDGE_NODE_ID=jetson-nano-2
EDGE_NODE_ROLE=classifier
ALERT_ENABLED=1

# --- Kafka (Mac IP — must match MAC_IP in cluster/spark_cluster.env) ---
KAFKA_BOOTSTRAP_SERVERS=192.168.1.165:9092
KAFKA_TOPIC=ids-network-flow
KAFKA_SUSPICIOUS_TOPIC=ids-suspicious-flow
KAFKA_CLASSIFIER_GROUP_ID=ids-classifier-consumer

# --- PostgreSQL / InfluxDB ---
POSTGRES_HOST=192.168.1.165
POSTGRES_PORT=5433
POSTGRES_DB=ids_edge
POSTGRES_USER=ids
POSTGRES_PASSWORD=ids_password

INFLUXDB_URL=http://192.168.1.165:8086
INFLUXDB_TOKEN=ids-edge-token
INFLUXDB_ORG=thesis
INFLUXDB_BUCKET=ids_metrics

# --- Spark (Mac master; driver on Jetson #1 — edge inference only) ---
SPARK_MASTER=spark://192.168.1.165:7077
SPARK_DRIVER_HOST=192.168.1.50
SPARK_EXECUTOR_MEMORY=3g
SPARK_DRIVER_MEMORY=3g
SPARK_SHUFFLE_PARTITIONS=32
SPARK_APP_NAME=IDS_Edge_jetson-nano-2

# --- Edge pipeline ---
EDGE_BATCH_SIZE=16
METRICS_PUSH_INTERVAL=10
ALERT_COOLDOWN=60

# --- Alerts ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=ids-alert@jetson-nano-2.local
ALERT_EMAIL_TO=
WEBHOOK_URL=
