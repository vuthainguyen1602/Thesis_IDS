# ==============================================================================
# Spark cluster: 1× Mac (master) + 2× Jetson Nano Super Kit 8GB (workers)
# Copy to cluster/spark_cluster.env (REQUIRED — all reproduce scripts use distributed mode)
# ==============================================================================

# --- Enable distributed mode (required for cluster scripts) ---
export IDS_SPARK_CLUSTER=1

# --- Network (replace with your LAN IPs) ---
export MAC_IP=192.168.1.165
export JETSON1_IP=192.168.1.50
export JETSON2_IP=192.168.1.205

# PySpark / ML client URL (do NOT export when calling sbin/start-*.sh — see start_master_mac.sh)
export SPARK_MASTER=spark://${MAC_IP}:7077
export SPARK_MASTER_WEBUI=http://${MAC_IP}:8080

# Driver runs on Jetson #1 (has synced data + enough RAM for PySpark driver)
export SPARK_DRIVER_HOST=${JETSON1_IP}
export JETSON_SSH_USER=bvdung
export CLUSTER_DRIVER=${JETSON_SSH_USER}@${JETSON1_IP}
export CLUSTER_DRIVER_IDS_ROOT=/home/${JETSON_SSH_USER}/Thesis_IDS

# Same path on ALL workers after cluster/sync_workspace.sh
export IDS_CLUSTER_DATA_DIR=${CLUSTER_DRIVER_IDS_ROOT}/data
# Remote project root on Jetsons (set IDS_MAC_ROOT on Mac — see sync_workspace.sh)
export IDS_MAC_ROOT=/Users/you/Desktop/Thesis_IDS

# Worker tuning (Jetson Nano Super Kit 8GB RAM, 256GB SSD — both nodes identical)
export SPARK_EXECUTOR_MEMORY=3g
export SPARK_EXECUTOR_CORES=4
export SPARK_DRIVER_MEMORY=3g
export SPARK_DRIVER_MAX_RESULT_SIZE=3g
export SPARK_SHUFFLE_PARTITIONS=32
export SPARK_WORKER_MEMORY=5g
export SPARK_WORKER_CORES=4

# SSH targets for sync (user@ip)
export JETSON1_SSH=${JETSON_SSH_USER}@${JETSON1_IP}
export JETSON2_SSH=${JETSON_SSH_USER}@${JETSON2_IP}

# 0 = only Jetson #1 (trial); 1 = sync/stop/check both workers
export JETSON2_ENABLED=1

# Raw CSV stays on Mac; parquet synced to Jetsons
export IDS_RAW_DATA_DIR=/Users/you/Desktop/ids-2017
export IDS_DATA_DIR=/Users/you/Desktop/Thesis_IDS/data

# Edge / Kafka still point to Mac Docker
export KAFKA_BOOTSTRAP_SERVERS=${MAC_IP}:9092
export POSTGRES_HOST=${MAC_IP}
export INFLUXDB_URL=http://${MAC_IP}:8086
