# Python
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
*.egg-info/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# LaTeX build artifacts
*.aux
*.log
*.blg
*.out
*.toc
*.lof
*.lot
*.synctex.gz
*.fdb_latexmk
*.fls
*.xdv
missfont.log
papers/*/manuscript/main.pdf
thesis/manuscript/main.pdf
thesis/main.pdf

# Beamer build artifacts (slides/) — the deliverable PDFs live in output/pdfs/
*.nav
*.snm
*.vrb
slides/*/main.pdf
slides/*/main_notes.pdf

# Keep exported PDFs here
!output/pdfs/*.pdf

# Data & large artifacts (keep local, do not commit)
data/
data_smoke/
*.parquet
*.parquet.crc

# Experiment outputs (regenerate via reproduce.sh)
results/*
exp*_results/
exp7_comparison/
feature_importance.csv
best_config.json

# Edge runtime / models
jetson/model/ids_pipeline*/
jetson/model/*.pkl
jetson/model/*.npz
jetson/model/*.onnx
jetson/.env
cluster/spark_cluster.env

!results/.gitkeep
# Keep the cross-dataset results (source of tab:cross_dataset; generated on the Jetson cluster)
!results/ml_11_cross_dataset/
!results/ml_11_cross_dataset/**
# Keep the summary CSV/JSON that the thesis tables are read from: 92 KB in
# total against 25 MB of regenerable parquet, models and figures, and an
# adaptation run was already lost to an overwrite before it could be pulled.
# Figures and per-model artefacts stay ignored.
!results/ml_01_baseline/
results/ml_01_baseline/*
!results/ml_01_baseline/*.csv
!results/ml_02_feature_selection_rf/
results/ml_02_feature_selection_rf/*
!results/ml_02_feature_selection_rf/*.csv
!results/ml_05_shap_explainability/
results/ml_05_shap_explainability/*
!results/ml_05_shap_explainability/*.csv
!results/ml_06_feature_selection_shap/
results/ml_06_feature_selection_shap/*
!results/ml_06_feature_selection_shap/*.csv
!results/ml_07_cross_method_comparison/
results/ml_07_cross_method_comparison/*
!results/ml_07_cross_method_comparison/*.csv
!results/ml_08_anomaly_gate/
results/ml_08_anomaly_gate/*
!results/ml_08_anomaly_gate/*.csv
!results/ml_09_multiclass_eval/
results/ml_09_multiclass_eval/*
!results/ml_09_multiclass_eval/*.csv
!results/ml_09_multiclass_eval/multiclass_summary.json
!results/ml_10_leakage_ablation/
results/ml_10_leakage_ablation/*
!results/ml_10_leakage_ablation/*.csv
# ml_03 writes no CSV, so this report is the only record of the 35 numbers in
# tab:exp2_ml_metrics.
!results/ml_03_hyperparameter_tuning/
results/ml_03_hyperparameter_tuning/*
!results/ml_03_hyperparameter_tuning/report.html
papers/fair2026/tables/
papers/fair2026/results/
# Energy and latency are measured on the boards, so a lost file cannot be
# regenerated by re-running code the way a model result can. The aggregates the
# manuscripts and tab:edge_* read from are kept; the 3.1 MB of raw per-run
# telemetry they were computed from stays out. (A directory pattern stops git
# descending at all, so the directory is un-ignored and its contents excluded.)
!papers/soict2026/results/benchmarks/
papers/soict2026/results/benchmarks/*
!papers/soict2026/results/benchmarks/benchmark_energy_rf.json
!papers/soict2026/results/benchmarks/benchmark_engines_results.json
!papers/soict2026/results/benchmarks/summary.csv

# Regenerable LaTeX previews / backups / scratch notes
*_preview.pdf
*_backup.tex
IDS_briefing_*.md

# run_all.sh runtime
.run_all_state/
output/run_all_logs/
*.bcf
*.run.xml
run_all_logs/
